@@ -1534,6 +1537,82 @@ VkSwapchainKHR VulkanPresenter::PaintContext::CreateSwapchainForVulkanSurface(
   return swapchain;
 }
 
+namespace {
+
+// Acquire-synchronization replacement operations (see
+// swapchain_acquire_sync_recovery.h) over VulkanDevice::Functions, matching the
+// create infos Submission::Initialize uses.
+struct AcquireSyncOpsContext {
+  const VulkanDevice::Functions* functions;
+  VkDevice device;
+};
+
+VkResult CreateAcquireSyncSemaphore(void* context, VkSemaphore* out_semaphore) {
+  const AcquireSyncOpsContext& ops_context = *static_cast<AcquireSyncOpsContext*>(context);
+  VkSemaphoreCreateInfo create_info = {};
+  create_info.sType = VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO;
+  return ops_context.functions->vkCreateSemaphore(ops_context.device, &create_info, nullptr,
+                                                  out_semaphore);
+}
+
+VkResult CreateAcquireSyncFence(void* context, VkFence* out_fence) {
+  const AcquireSyncOpsContext& ops_context = *static_cast<AcquireSyncOpsContext*>(context);
+  VkFenceCreateInfo create_info = {};
+  create_info.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO;
+  return ops_context.functions->vkCreateFence(ops_context.device, &create_info, nullptr, out_fence);
+}
+
+void DestroyAcquireSyncSemaphore(void* context, VkSemaphore semaphore) {
+  const AcquireSyncOpsContext& ops_context = *static_cast<AcquireSyncOpsContext*>(context);
+  ops_context.functions->vkDestroySemaphore(ops_context.device, semaphore, nullptr);
+}
+
+void DestroyAcquireSyncFence(void* context, VkFence fence) {
+  const AcquireSyncOpsContext& ops_context = *static_cast<AcquireSyncOpsContext*>(context);
+  ops_context.functions->vkDestroyFence(ops_context.device, fence, nullptr);
+}
+
+}  // namespace
+
+// Called only after all submissions have completed and the queues are idle, so
+// no in-flight work references the acquire semaphores and fences being replaced.
+void VulkanPresenter::PaintContext::RecoverAcquireSyncAfterRetirement() {
+  if (acquire_sync_recovery_pending_ == 0) {
+    return;
+  }
+  const uint32_t slot_count = uint32_t(submissions.size());
+  AcquireSyncHandles handles[PaintContext::kSubmissionCount];
+  for (uint32_t slot = 0; slot < slot_count; ++slot) {
+    const Submission* submission = submissions[slot].get();
+    handles[slot].semaphore = submission ? submission->acquire_semaphore() : VK_NULL_HANDLE;
+    handles[slot].fence = submission ? submission->acquire_fence() : VK_NULL_HANDLE;
+  }
+  AcquireSyncOpsContext ops_context = {&vulkan_device->functions(), vulkan_device->device()};
+  const AcquireSyncOps ops = {
+      CreateAcquireSyncSemaphore,
+      CreateAcquireSyncFence,
+      DestroyAcquireSyncSemaphore,
+      DestroyAcquireSyncFence,
+      &ops_context,
+  };
+  const uint32_t failed_mask =
+      ReplacePendingAcquireSync(ops, acquire_sync_recovery_pending_, handles, slot_count);
+  for (uint32_t slot = 0; slot < slot_count; ++slot) {
+    Submission* submission = submissions[slot].get();
+    if (submission) {
+      submission->set_acquire_sync(handles[slot].semaphore, handles[slot].fence);
+    }
+  }
+  acquire_sync_recovery_failed_mask_ |= failed_mask;
+  acquire_sync_recovery_pending_ = failed_mask;
+  if (failed_mask != 0) {
+    REXLOG_ERROR(
+        "VulkanPresenter: Failed to replace the macOS acquire semaphore and "
+        "fence after a swapchain reconnect; the affected submissions will not "
+        "be reused");
+  }
+}
