diff --git a/src/ui/vulkan/swapchain_acquire_recovery.h b/src/ui/vulkan/swapchain_acquire_recovery.h
new file mode 100644
index 0000000..05856cb
--- /dev/null
+++ b/src/ui/vulkan/swapchain_acquire_recovery.h
@@ -0,0 +1,72 @@
+/**
+ ******************************************************************************
+ * ReStreet : macOS MoltenVK swapchain acquire recovery classification
+ ******************************************************************************
+ *
+ * Focused, dependency-light classification of vkAcquireNextImageKHR results so
+ * the presenter's recovery decision is one testable function rather than a
+ * branch buried at the end of PaintAndPresentImpl.
+ *
+ * MoltenVK (macOS) reports VK_ERROR_OUT_OF_POOL_MEMORY from
+ * MVKPresentableSwapchainImage::getCAMetalDrawable() when it cannot obtain a
+ * CAMetalDrawable after retrying the swapchain image count. The source comment
+ * there says the error is deliberately set to trigger the swapchain to be
+ * re-established, and acquireAndSignalWhenAvailable() returns that sticky
+ * configuration result to vkAcquireNextImageKHR. The presenter previously fell
+ * through to its default branch (kNotPresented), so the requested recreation
+ * never happened and the image the acquire had already handed out stayed
+ * acquired.
+ *
+ * This closes that source gap only. Whether the gap is what produces the
+ * observed macOS black screen is NOT established: the runtime wedge has not been
+ * reproduced against this change, so the black-screen relation remains unproven.
+ *
+ * On Vulkan drivers other than MoltenVK, VK_ERROR_OUT_OF_POOL_MEMORY is not a
+ * documented vkAcquireNextImageKHR result, so it stays an unclassified failure
+ * there; only the macOS/MoltenVK path treats it as a reconnect request.
+ */
+
+#pragma once
+
+#include <vulkan/vulkan_core.h>
+
+namespace rex::ui::vulkan {
+
+// What the presenter should do after vkAcquireNextImageKHR.
+enum class SwapchainAcquireOutcome {
+  kProceed,     // An image was acquired; continue drawing and submitting.
+  kRetry,       // No image this iteration; drop the frame, keep the swapchain.
+  kReconnect,   // Drop the frame and mark the connection outdated so the
+                // presenter recreates the swapchain.
+  kDeviceLost,  // Report host GPU loss.
+  kFailed,      // Unclassified failure; drop the frame and log.
+};
+
+// `moltenvk_present` is true only on the macOS MoltenVK runtime. It is an
+// explicit parameter rather than a compile-time platform check so the
+// platform-specific pool-memory mapping can be exercised directly by
+// scripts/drawable_recovery_test.cpp.
+inline SwapchainAcquireOutcome ClassifySwapchainAcquireResult(VkResult result,
+                                                              bool moltenvk_present) {
+  switch (result) {
+    case VK_SUCCESS:
+    case VK_SUBOPTIMAL_KHR:
+      return SwapchainAcquireOutcome::kProceed;
+    case VK_TIMEOUT:
+    case VK_NOT_READY:
+      return SwapchainAcquireOutcome::kRetry;
+    case VK_ERROR_DEVICE_LOST:
+      return SwapchainAcquireOutcome::kDeviceLost;
+    case VK_ERROR_OUT_OF_DATE_KHR:
+    case VK_ERROR_SURFACE_LOST_KHR:
+    case VK_ERROR_FULL_SCREEN_EXCLUSIVE_MODE_LOST_EXT:
+      return SwapchainAcquireOutcome::kReconnect;
+    case VK_ERROR_OUT_OF_POOL_MEMORY:
+      return moltenvk_present ? SwapchainAcquireOutcome::kReconnect
+                              : SwapchainAcquireOutcome::kFailed;
+    default:
+      return SwapchainAcquireOutcome::kFailed;
+  }
+}
+
+}  // namespace rex::ui::vulkan
diff --git a/src/ui/vulkan/swapchain_acquire_sync_recovery.h b/src/ui/vulkan/swapchain_acquire_sync_recovery.h
new file mode 100644
index 0000000..9aa4c67
--- /dev/null
+++ b/src/ui/vulkan/swapchain_acquire_sync_recovery.h
@@ -0,0 +1,101 @@
+/**
+ ******************************************************************************
+ * ReStreet : macOS MoltenVK acquire synchronization recovery after a reconnect
+ ******************************************************************************
+ *
+ * MoltenVK signals the acquire semaphore and fence inside
+ * MVKPresentableSwapchainImage::acquireAndSignalWhenAvailable() (MVKImage.mm
+ * 1537-1575) before MVKSwapchain::acquireNextImage() returns the result of
+ * getConfigurationResult(), i.e. before returning a stale
+ * VK_ERROR_OUT_OF_POOL_MEMORY that requests swapchain re-establishment, and
+ * before returning the VK_ERROR_OUT_OF_DATE_KHR /
+ * VK_ERROR_SURFACE_LOST_KHR that getSurfaceStatus() (MVKSwapchain.mm 103,
+ * 122-127) produces after the acquire. Core Vulkan requires the semaphore
+ * passed to vkAcquireNextImageKHR to be unsignaled, and the presenter resets
+ * only the acquire fence, so reusing that semaphore for the next acquire passes
+ * a possibly-signaled binary semaphore to the driver.
+ *
+ * On conformant drivers this cannot happen: they do not signal the acquire
+ * semaphore when the acquire does not succeed, so the presenter's existing
+ * reconnect handling never leaves it signaled. On MoltenVK the semaphore must
+ * therefore not be reused blindly after a reconnect-class acquire result; it is
+ * replaced once every in-flight reference to it has ceased.
+ *
+ * The replacement is deliberately a create-then-destroy of the handles rather
+ * than a wait or a reset: binary semaphores cannot be reset in core Vulkan, and
+ * waiting for a signal that MoltenVK may not have emitted (it also queues
+ * signalers that are only signaled, or dropped, when the image is retired) could
+ * block forever.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <vulkan/vulkan_core.h>
+
+namespace rex::ui::vulkan {
+
+// The acquire semaphore and fence of one presenter submission slot. They are
+// owned by the presenter's submission (connection-independent) rather than by
+// the swapchain.
+struct AcquireSyncHandles {
+  VkSemaphore semaphore = VK_NULL_HANDLE;
+  VkFence fence = VK_NULL_HANDLE;
+};
+
+// Host operations needed to replace an acquire semaphore and fence. Production
+// wraps VulkanDevice::Functions; the unit test supplies a fake that records the
+// call order and can inject creation failures.
+struct AcquireSyncOps {
+  VkResult (*create_semaphore)(void* context, VkSemaphore* out_semaphore);
+  VkResult (*create_fence)(void* context, VkFence* out_fence);
+  void (*destroy_semaphore)(void* context, VkSemaphore semaphore);
+  void (*destroy_fence)(void* context, VkFence fence);
+  void* context;
+};
+
+// Replaces the acquire semaphore and fence of every slot selected by
+// `pending_mask`, where `handles` has `slot_count` entries.
+//
+// The replacement pair is created before the old pair is destroyed, so a
+// creation failure leaves the slot's existing (possibly signaled) handles in
+// place rather than leaving it with no handles, and the slot is reported as
+// still pending. The function performs no waits, so a signal MoltenVK has not
+// emitted yet cannot make it block; the caller must instead invoke it only
+// after all in-flight references to the selected slots have ceased
+// (submissions completed and the queues idle), because the old handles are
+// destroyed here.
+//
+// Returns the subset of `pending_mask` that could not be replaced.
+inline uint32_t ReplacePendingAcquireSync(const AcquireSyncOps& ops, uint32_t pending_mask,
+                                          AcquireSyncHandles* handles, uint32_t slot_count) {
+  uint32_t failed_mask = 0;
+  for (uint32_t slot = 0; slot < slot_count; ++slot) {
+    const uint32_t slot_bit = uint32_t(1) << slot;
+    if (!(pending_mask & slot_bit)) {
+      continue;
+    }
+    VkSemaphore new_semaphore = VK_NULL_HANDLE;
+    VkFence new_fence = VK_NULL_HANDLE;
+    if (ops.create_semaphore(ops.context, &new_semaphore) != VK_SUCCESS) {
+      failed_mask |= slot_bit;
+      continue;
+    }
+    if (ops.create_fence(ops.context, &new_fence) != VK_SUCCESS) {
+      ops.destroy_semaphore(ops.context, new_semaphore);
+      failed_mask |= slot_bit;
+      continue;
+    }
+    if (handles[slot].semaphore != VK_NULL_HANDLE) {
+      ops.destroy_semaphore(ops.context, handles[slot].semaphore);
+    }
+    if (handles[slot].fence != VK_NULL_HANDLE) {
+      ops.destroy_fence(ops.context, handles[slot].fence);
+    }
+    handles[slot].semaphore = new_semaphore;
+    handles[slot].fence = new_fence;
+  }
+  return failed_mask;
+}
+
+}  // namespace rex::ui::vulkan
