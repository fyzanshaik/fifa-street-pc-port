+  // Opt-in Mac presentation workaround (RESTREET_PRESENT_ASYNC_SUBMIT). MoltenVK
+  // defaults to MVK_CONFIG_SYNCHRONOUS_QUEUE_SUBMITS=1, which encodes a
+  // vkQueueSubmit inline on the calling thread: the Metal drawable is acquired
+  // (and can block in -[CAMetalLayer nextDrawable]) while the caller still holds
+  // the SDK's shared per-queue host-access mutex, which can starve the guest GPU
+  // thread. Setting the variable to 0 moves encoding onto MoltenVK's own
+  // dispatch queue, releasing that mutex as soon as vkQueueSubmit is enqueued.
+  // This is an untested hypothesis, applied only when explicitly requested and
+  // only when the user has not already chosen a value.
+  {
+    const char* requested = std::getenv("RESTREET_PRESENT_ASYNC_SUBMIT");
+    const char* existing = std::getenv("MVK_CONFIG_SYNCHRONOUS_QUEUE_SUBMITS");
+    if (requested && requested[0] && requested[0] != '0' && (!existing || !existing[0])) {
+      setenv("MVK_CONFIG_SYNCHRONOUS_QUEUE_SUBMITS", "0", 1);
+      REXLOG_INFO(
+          "MoltenVK: asynchronous queue submission enabled by RESTREET_PRESENT_ASYNC_SUBMIT "
+          "(MVK_CONFIG_SYNCHRONOUS_QUEUE_SUBMITS=0)");
+    }
+  }
 }
 
