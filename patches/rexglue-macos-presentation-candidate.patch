@@ -0,0 +1,254 @@
+/**
+ ******************************************************************************
+ * ReStreet : macOS present-submit diagnostics state machine
+ ******************************************************************************
+ *
+ * Opt-in bookkeeping for the macOS present/submit freeze investigation.
+ *
+ * The presenting thread brackets each present envelope in three calls:
+ *   Begin()            - before AcquireQueue, so the queue-lock wait is timed;
+ *   EnterSubmitPhase() - once AcquireQueue returned (the shared queue mutex is
+ *                        held) and vkQueueSubmit is about to run;
+ *   End()              - on *every* return path, clearing the outstanding
+ *                        envelope. A fast return is therefore never left
+ *                        looking "in flight".
+ *
+ * A separate watchdog thread calls Tick() a few times a second. Tick() returns
+ * the bounded set of lines that should be logged now: a once-per-interval
+ * summary, at most one long-submit line per interval, and at most one watchdog
+ * line per outstanding episode. There is deliberately no per-submit logging, so
+ * a healthy 60 Hz run emits ~1 line/s, not 60.
+ *
+ * This header is std-only and has no ReXGlue dependency so the exact state
+ * machine can be driven by test/present_diag_state_test.cpp with synthetic
+ * timestamps and no thread, GPU or guest code. The runtime wrapper lives in
+ * vulkan_presenter.cpp and is inert unless RESTREET_PRESENT_DIAG is set.
+ */
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <vector>
+
+namespace rex::ui::vulkan::present_diag {
+
+enum class EventKind : uint8_t {
+  kNone = 0,
+  kSummary,     // once per config.summary_interval_ns
+  kLongSubmit,  // first slow completion since the last long-submit line
+  kWatchdog,    // once per outstanding episode that crosses config.watchdog_ns
+};
+
+// Consistent-enough read of the live counters. Field reads are atomic; a
+// watchdog snapshot may interleave with an in-flight envelope, which is
+// acceptable for a diagnostic line.
+struct Snapshot {
+  uint64_t started = 0;            // present envelopes begun
+  uint64_t completed = 0;          // present envelopes returned
+  int64_t last_result = 0;         // last VkResult cast to int
+  int64_t max_duration_ns = 0;     // max whole-envelope duration so far
+  uint64_t active_id = 0;          // id of the outstanding envelope; 0 = none
+  int64_t active_duration_ns = 0;  // now - active start; 0 when none outstanding
+  uint64_t swapchain_generation = 0;
+  int64_t acquire_max_ns = 0;  // max time blocked acquiring the queue lock
+  int64_t submit_max_ns = 0;   // max time inside vkQueueSubmit (lock held)
+  uint64_t slow_completed = 0; // completions >= config.long_submit_ns
+  bool in_submit_phase = false; // outstanding envelope is past AcquireQueue
+};
+
+struct Event {
+  EventKind kind = EventKind::kNone;
+  Snapshot snapshot;
+  uint64_t id = 0;                // envelope id the line refers to
+  int64_t duration_ns = 0;        // whole envelope
+  int64_t acquire_ns = 0;         // Begin -> EnterSubmitPhase (queue lock wait)
+  int64_t submit_ns = 0;          // EnterSubmitPhase -> End (vkQueueSubmit)
+  int result = 0;                 // VkResult cast to int
+  uint64_t swapchain_generation = 0;
+};
+
+class State {
+ public:
+  struct Config {
+    int64_t summary_interval_ns = 1'000'000'000;  // one summary line per second
+    int64_t long_submit_ns = 200'000'000;         // "slow" threshold
+    int64_t watchdog_ns = 2'000'000'000;          // "not returned" threshold
+  };
+
+  State() = default;
+  explicit State(const Config& config) : config_(config) {}
+
+  // Presenting thread: begin a present envelope. Returns its id.
+  uint64_t Begin(int64_t now_ns) {
+    const uint64_t id = started_.fetch_add(1, std::memory_order_relaxed) + 1;
+    active_acquire_ns_.store(0, std::memory_order_relaxed);
+    phase_.store(kAcquiring, std::memory_order_relaxed);
+    watchdog_reported_.store(false, std::memory_order_relaxed);
+    active_start_ns_.store(now_ns, std::memory_order_relaxed);
+    active_id_.store(id, std::memory_order_release);
+    return id;
+  }
+
+  // Presenting thread: AcquireQueue returned and holds the queue mutex.
+  void EnterSubmitPhase(int64_t now_ns) {
+    const int64_t start_ns = active_start_ns_.load(std::memory_order_relaxed);
+    active_acquire_ns_.store(now_ns - start_ns, std::memory_order_relaxed);
+    submit_start_ns_.store(now_ns, std::memory_order_relaxed);
+    phase_.store(kSubmitting, std::memory_order_relaxed);
+  }
+
+  // Presenting thread: every return path. Always clears the outstanding
+  // envelope, so a fast (or failed) return is never reported as in flight.
+  void End(uint64_t id, int result, int64_t now_ns) {
+    if (active_id_.load(std::memory_order_acquire) != id) {
+      return;  // stale id: never clear a newer in-flight envelope
+    }
+    const int64_t start_ns = active_start_ns_.load(std::memory_order_relaxed);
+    const bool submitting = phase_.load(std::memory_order_relaxed) == kSubmitting;
+    const int64_t acquire_ns =
+        submitting ? active_acquire_ns_.load(std::memory_order_relaxed) : (now_ns - start_ns);
+    const int64_t submit_ns =
+        submitting ? (now_ns - submit_start_ns_.load(std::memory_order_relaxed)) : 0;
+    const int64_t duration_ns = now_ns - start_ns;
+    const uint64_t swapchain_generation = swapchain_generation_.load(std::memory_order_relaxed);
+
+    UpdateMax(acquire_max_ns_, acquire_ns);
+    UpdateMax(submit_max_ns_, submit_ns);
+    UpdateMax(max_duration_ns_, duration_ns);
+    last_result_.store(result, std::memory_order_relaxed);
+
+    if (duration_ns >= config_.long_submit_ns) {
+      // Remember the most recent slow completion; Tick() decides when to log it.
+      last_slow_id_.store(id, std::memory_order_relaxed);
+      last_slow_duration_ns_.store(duration_ns, std::memory_order_relaxed);
+      last_slow_acquire_ns_.store(acquire_ns, std::memory_order_relaxed);
+      last_slow_submit_ns_.store(submit_ns, std::memory_order_relaxed);
+      last_slow_result_.store(result, std::memory_order_relaxed);
+      last_slow_swapchain_.store(swapchain_generation, std::memory_order_relaxed);
+      slow_count_.fetch_add(1, std::memory_order_relaxed);
+    }
+
+    completed_.fetch_add(1, std::memory_order_relaxed);
+    phase_.store(kIdle, std::memory_order_relaxed);
+    active_id_.store(0, std::memory_order_release);
+    watchdog_reported_.store(false, std::memory_order_relaxed);
+  }
+
+  // Presenting thread: a new swapchain exists. Returns its generation.
+  uint64_t NoteSwapchainCreated() {
+    return swapchain_generation_.fetch_add(1, std::memory_order_relaxed) + 1;
+  }
+
+  Snapshot snapshot(int64_t now_ns) const {
+    Snapshot s;
+    s.started = started_.load(std::memory_order_relaxed);
+    s.completed = completed_.load(std::memory_order_relaxed);
+    s.last_result = last_result_.load(std::memory_order_relaxed);
+    s.max_duration_ns = max_duration_ns_.load(std::memory_order_relaxed);
+    s.active_id = active_id_.load(std::memory_order_acquire);
+    s.swapchain_generation = swapchain_generation_.load(std::memory_order_relaxed);
+    s.acquire_max_ns = acquire_max_ns_.load(std::memory_order_relaxed);
+    s.submit_max_ns = submit_max_ns_.load(std::memory_order_relaxed);
+    s.slow_completed = slow_count_.load(std::memory_order_relaxed);
+    s.in_submit_phase = phase_.load(std::memory_order_relaxed) == kSubmitting;
+    if (s.active_id != 0) {
+      s.active_duration_ns = now_ns - active_start_ns_.load(std::memory_order_relaxed);
+    }
+    return s;
+  }
+
+  // Watchdog thread (or a test). Returns the bounded lines to log now.
+  std::vector<Event> Tick(int64_t now_ns) {
+    std::vector<Event> events;
+
+    // At most one watchdog line per outstanding episode. End() resets the flag,
+    // so a later envelope can report again.
+    const uint64_t active = active_id_.load(std::memory_order_acquire);
+    if (active != 0 && !watchdog_reported_.load(std::memory_order_relaxed)) {
+      const int64_t start_ns = active_start_ns_.load(std::memory_order_relaxed);
+      if (now_ns - start_ns >= config_.watchdog_ns) {
+        watchdog_reported_.store(true, std::memory_order_relaxed);
+        const bool submitting = phase_.load(std::memory_order_relaxed) == kSubmitting;
+        Event event;
+        event.kind = EventKind::kWatchdog;
+        event.id = active;
+        event.duration_ns = now_ns - start_ns;
+        event.acquire_ns = active_acquire_ns_.load(std::memory_order_relaxed);
+        event.submit_ns =
+            submitting ? (now_ns - submit_start_ns_.load(std::memory_order_relaxed)) : 0;
+        event.snapshot = snapshot(now_ns);
+        events.push_back(event);
+      }
+    }
+
+    // At most one long-submit line per interval; repeated slow completions in
+    // the same interval only bump slow_completed (visible in the summary).
+    const uint64_t slow = slow_count_.load(std::memory_order_relaxed);
+    if (slow > slow_reported_.load(std::memory_order_relaxed) &&
+        now_ns - last_slow_report_ns_.load(std::memory_order_relaxed) >=
+            config_.summary_interval_ns) {
+      slow_reported_.store(slow, std::memory_order_relaxed);
+      last_slow_report_ns_.store(now_ns, std::memory_order_relaxed);
+      Event event;
+      event.kind = EventKind::kLongSubmit;
+      event.id = last_slow_id_.load(std::memory_order_relaxed);
+      event.duration_ns = last_slow_duration_ns_.load(std::memory_order_relaxed);
+      event.acquire_ns = last_slow_acquire_ns_.load(std::memory_order_relaxed);
+      event.submit_ns = last_slow_submit_ns_.load(std::memory_order_relaxed);
+      event.result = last_slow_result_.load(std::memory_order_relaxed);
+      event.swapchain_generation = last_slow_swapchain_.load(std::memory_order_relaxed);
+      event.snapshot = snapshot(now_ns);
+      events.push_back(event);
+    }
+
+    // At most one summary per interval.
+    if (now_ns - last_summary_ns_.load(std::memory_order_relaxed) >=
+        config_.summary_interval_ns) {
+      last_summary_ns_.store(now_ns, std::memory_order_relaxed);
+      Event event;
+      event.kind = EventKind::kSummary;
+      event.snapshot = snapshot(now_ns);
+      events.push_back(event);
+    }
+
+    return events;
+  }
+
+ private:
+  enum Phase : int { kIdle = 0, kAcquiring = 1, kSubmitting = 2 };
+
+  static void UpdateMax(std::atomic<int64_t>& target, int64_t value) {
+    int64_t current = target.load(std::memory_order_relaxed);
+    while (value > current &&
+           !target.compare_exchange_weak(current, value, std::memory_order_relaxed)) {
+    }
+  }
+
+  Config config_;
+  std::atomic<uint64_t> started_{0};
+  std::atomic<uint64_t> completed_{0};
+  std::atomic<int64_t> last_result_{0};
+  std::atomic<int64_t> max_duration_ns_{0};
+  std::atomic<uint64_t> active_id_{0};
+  std::atomic<int64_t> active_start_ns_{0};
+  std::atomic<int64_t> active_acquire_ns_{0};
+  std::atomic<int64_t> submit_start_ns_{0};
+  std::atomic<int> phase_{kIdle};
+  std::atomic<uint64_t> swapchain_generation_{0};
+  std::atomic<int64_t> acquire_max_ns_{0};
+  std::atomic<int64_t> submit_max_ns_{0};
+  std::atomic<uint64_t> slow_count_{0};
+  std::atomic<uint64_t> slow_reported_{0};
+  std::atomic<int64_t> last_slow_report_ns_{0};
+  std::atomic<uint64_t> last_slow_id_{0};
+  std::atomic<int64_t> last_slow_duration_ns_{0};
+  std::atomic<int64_t> last_slow_acquire_ns_{0};
+  std::atomic<int64_t> last_slow_submit_ns_{0};
+  std::atomic<int> last_slow_result_{0};
+  std::atomic<uint64_t> last_slow_swapchain_{0};
+  std::atomic<bool> watchdog_reported_{false};
+  std::atomic<int64_t> last_summary_ns_{0};
+};
+
+}  // namespace rex::ui::vulkan::present_diag
