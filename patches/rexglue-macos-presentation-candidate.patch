 namespace {
 
+#if REX_PLATFORM_MAC
+// Opt-in present-submit diagnostics for the macOS freeze investigation, enabled
+// only when RESTREET_PRESENT_DIAG is set. present_diag_state.h classifies every
+// present envelope (queue-lock wait vs vkQueueSubmit vs outstanding) and this
+// wrapper emits only bounded lines: a once-per-second summary, at most one
+// long-submit line per interval and one watchdog line per outstanding episode.
+// There is no per-submit logging, so a healthy 60 Hz run logs ~1 line/s. The
+// variable is read once; when unset nothing here records or logs or starts a
+// thread (one predictable, cached branch per present).
+bool PresentDiagEnabled() {
+  static const bool enabled = [] {
+    const char* value = std::getenv("RESTREET_PRESENT_DIAG");
+    return value && value[0] && value[0] != '0';
+  }();
+  return enabled;
+}
+
+int64_t PresentDiagNowNs() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+struct PresentDiagRuntime {
+  present_diag::State state;
+  std::mutex mutex;
+  std::condition_variable wake;
+  std::thread watchdog;
+  std::atomic<bool> stop{false};
+  std::atomic<bool> armed{false};
+
+  ~PresentDiagRuntime() { Stop(); }
+
+  // Idempotent stop+join, safe to call from ~VulkanPresenter and again from the
+  // static destructor. `armed` is cleared only after the join, so it always
+  // means "a live watchdog exists": a presenter rebuilt in the same process
+  // re-arms instead of silently going dark, and a concurrent Ensure() can never
+  // observe armed=true over an already-joined thread.
+  void Stop() {
+    {
+      std::lock_guard<std::mutex> lock(mutex);
+      stop.store(true, std::memory_order_release);
+    }
+    wake.notify_all();
+    if (watchdog.joinable()) {
+      watchdog.join();
+    }
+    armed.store(false, std::memory_order_release);
+  }
+};
+
+PresentDiagRuntime& PresentDiagnostics() {
+  static PresentDiagRuntime runtime;
+  return runtime;
+}
+
+void LogPresentDiagEvent(const present_diag::Event& event) {
+  const present_diag::Snapshot& s = event.snapshot;
+  switch (event.kind) {
+    case present_diag::EventKind::kSummary: {
+      // Distinguishes the three cases at a glance: started == completed with
+      // activeID 0, phase idle and a small maxDuration is the fast-return path;
+      // phase acquire/submit is one outstanding envelope; activeID 0 with a
+      // large maxDuration and a rising slow count is repeated slow submits that
+      // do return.
+      const char* phase = s.active_id == 0 ? "idle" : (s.in_submit_phase ? "submit" : "acquire");
+      REXLOG_INFO(
+          "[PRESENTDIAG] summary started={} completed={} phase={} lastResult={} maxDurationMs={} "
+          "activeID={} activeDurationMs={} swapchainGen={} acquireMaxMs={} submitMaxMs={} "
+          "slow={}",
+          s.started, s.completed, phase, s.last_result, s.max_duration_ns / 1000000, s.active_id,
+          s.active_duration_ns / 1000000, s.swapchain_generation, s.acquire_max_ns / 1000000,
+          s.submit_max_ns / 1000000, s.slow_completed);
+      break;
+    }
+    case present_diag::EventKind::kLongSubmit:
+      REXLOG_WARN(
+          "[PRESENTDIAG] long submit #{} durationMs={} acquireMs={} submitMs={} result={} "
+          "swapchainGen={} (>=200ms; slow total={})",
+          event.id, event.duration_ns / 1000000, event.acquire_ns / 1000000,
+          event.submit_ns / 1000000, event.result, event.swapchain_generation, s.slow_completed);
+      break;
+    case present_diag::EventKind::kWatchdog:
+      REXLOG_WARN(
+          "[PRESENTDIAG] watchdog submit #{} outstanding {} ms phase={} acquireMs={} submitMs={} "
+          "started={} completed={} lastResult={} swapchainGen={} (nothing returned yet)",
+          event.id, event.duration_ns / 1000000, s.in_submit_phase ? "submit" : "acquire",
+          event.acquire_ns / 1000000, event.submit_ns / 1000000, s.started, s.completed,
+          s.last_result, s.swapchain_generation);
+      break;
+    case present_diag::EventKind::kNone:
+      break;
+  }
+}
+
+void PresentDiagWatchdogLoop() {
+  PresentDiagRuntime& runtime = PresentDiagnostics();
+  const auto interval = std::chrono::milliseconds(250);
+  std::unique_lock<std::mutex> lock(runtime.mutex);
+  while (!runtime.stop.load(std::memory_order_acquire)) {
+    runtime.wake.wait_for(lock, interval);
+    if (runtime.stop.load(std::memory_order_acquire)) {
+      break;
+    }
+    // Snapshot under the lock, but log without it so a slow logger never blocks
+    // the presenting thread's EnsurePresentDiagWatchdog().
+    std::vector<present_diag::Event> events = runtime.state.Tick(PresentDiagNowNs());
+    lock.unlock();
+    for (const present_diag::Event& event : events) {
+      LogPresentDiagEvent(event);
+    }
+    lock.lock();
+  }
+}
+
+void EnsurePresentDiagWatchdog() {
+  PresentDiagRuntime& runtime = PresentDiagnostics();
+  if (runtime.armed.load(std::memory_order_acquire)) {
+    return;  // Cheap branch: no lock on the hot path after the first present.
+  }
+  std::lock_guard<std::mutex> lock(runtime.mutex);
+  if (runtime.watchdog.joinable()) {
+    runtime.armed.store(true, std::memory_order_release);
+    return;
+  }
+  runtime.stop.store(false, std::memory_order_release);
+  runtime.watchdog = std::thread(PresentDiagWatchdogLoop);
+  runtime.armed.store(true, std::memory_order_release);
+}
+
+void StopPresentDiagWatchdog() { PresentDiagnostics().Stop(); }
+#endif  // REX_PLATFORM_MAC
