+/**
+ * @file        rex/input/input_diagnostics.h
+ * @brief       Opt-in, aggregated instrumentation for the keyboard-to-guest
+ *              input chain.
+ *
+ * The macOS MnK path has several gates between a physical key and the guest
+ * reading a controller button (SDL event delivery, window keyboard focus, the
+ * MnK driver's mnk_mode/has_focus/is_active gates, the bind parser, device
+ * assignment to guest user 0). When a key press has no effect it is not obvious
+ * which gate dropped it, and the normal logs cannot say because the guest input
+ * entry points only trace.
+ *
+ * This header records a small, coherent summary of every stage and emits one
+ * aggregated line at most once per second. It is inert - a single relaxed atomic
+ * load - unless RESTREET_INPUT_DIAG is set to a non-empty value other than "0".
+ * It never logs a stream of individual keystrokes: the counters and the last
+ * mapped button mask are what is reported, and only from the game's own window.
+ *
+ * @copyright   Copyright (c) 2026 Tom Clay <tomc@tctechstuff.com>
+ *              All rights reserved.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+#include <string_view>
+
+#include <rex/logging.h>
+
+namespace rex::input::diag {
+
+/// True only when the operator opted in via RESTREET_INPUT_DIAG. Read once.
+inline bool Enabled() {
+  static const bool enabled = [] {
+    const char* value = std::getenv("RESTREET_INPUT_DIAG");
+    return value != nullptr && *value != '\0' && std::string_view(value) != "0";
+  }();
+  return enabled;
+}
+
+/// Coherent summary of the whole chain. Every field is an independent atomic;
+/// the 1 Hz aggregation may therefore straddle a boundary, which is fine for a
+/// coarse "which stage is alive" report.
+struct Counters {
+  // window_sdl.cpp - the SDL event as delivered to the window.
+  std::atomic<uint64_t> sdl_down{0};
+  std::atomic<uint64_t> sdl_down_mapped{0};
+  std::atomic<uint64_t> sdl_down_unmapped{0};
+  std::atomic<uint64_t> sdl_up{0};
+  std::atomic<uint32_t> last_scancode{0};
+  std::atomic<uint32_t> last_vk{0};
+  std::atomic<uint32_t> last_focus{0};
+
+  // mnk_input_driver.cpp - OnKeyDown gate, and GetDeviceState gate.
+  std::atomic<uint64_t> mnk_down_seen{0};
+  std::atomic<uint64_t> mnk_down_disabled{0};
+  std::atomic<uint64_t> mnk_down_unfocused{0};
+  std::atomic<uint64_t> mnk_get{0};
+  std::atomic<uint64_t> mnk_gate_inactive{0};
+  std::atomic<uint64_t> mnk_gate_unfocused{0};
+  std::atomic<uint64_t> mnk_evaluated{0};
+  std::atomic<uint32_t> mnk_last_buttons{0};
+  std::atomic<uint64_t> mnk_a_hits{0};
+
+  // input_system.cpp - what the guest actually read for user 0.
+  std::atomic<uint64_t> guest_u0{0};
+  std::atomic<uint64_t> guest_u0_buttons{0};
+  std::atomic<uint64_t> guest_u0_a{0};
+  std::atomic<uint32_t> guest_last_buttons{0};
+  std::atomic<uint64_t> guest_other{0};
+  std::atomic<uint64_t> guest_ks_calls{0};
+  std::atomic<uint64_t> guest_ks_ok{0};
+
+  std::atomic<int64_t> last_flush_ms{-1000};
+};
+
+inline Counters& C() {
+  static Counters counters;
+  return counters;
+}
+
+inline int64_t NowMs() {
+  using clock = std::chrono::steady_clock;
+  static const clock::time_point start = clock::now();
+  return std::chrono::duration_cast<std::chrono::milliseconds>(clock::now() - start).count();
+}
+
+/// Emits at most one aggregated line per second. Cheap enough to call from the
+/// per-frame guest path: one relaxed load when disabled, one load plus an
+/// occasional compare-exchange when enabled.
+inline void MaybeFlush() {
+  if (!Enabled()) {
+    return;
+  }
+  Counters& c = C();
+  const int64_t now = NowMs();
+  int64_t last = c.last_flush_ms.load(std::memory_order_relaxed);
+  if (now - last < 1000) {
+    return;
+  }
+  if (!c.last_flush_ms.compare_exchange_strong(last, now, std::memory_order_relaxed)) {
+    return;  // another thread is already emitting this second
+  }
+  REXLOG_INFO(
+      "[input-diag] sdl down={} mapped={} unmapped={} up={} last_scan={} last_vk=0x{:X} "
+      "focus={} | mnk down_seen={} down_disabled={} down_unfocused={} get={} gate_inactive={} "
+      "gate_unfocused={} evaluated={} last_buttons=0x{:X} a_hits={} | guest u0={} u0_buttons={} "
+      "u0_a={} last_buttons=0x{:X} other={} ks_calls={} ks_ok={}",
+      c.sdl_down.load(std::memory_order_relaxed),
+      c.sdl_down_mapped.load(std::memory_order_relaxed),
+      c.sdl_down_unmapped.load(std::memory_order_relaxed),
+      c.sdl_up.load(std::memory_order_relaxed), c.last_scancode.load(std::memory_order_relaxed),
+      c.last_vk.load(std::memory_order_relaxed), c.last_focus.load(std::memory_order_relaxed),
+      c.mnk_down_seen.load(std::memory_order_relaxed),
+      c.mnk_down_disabled.load(std::memory_order_relaxed),
+      c.mnk_down_unfocused.load(std::memory_order_relaxed),
+      c.mnk_get.load(std::memory_order_relaxed),
+      c.mnk_gate_inactive.load(std::memory_order_relaxed),
+      c.mnk_gate_unfocused.load(std::memory_order_relaxed),
+      c.mnk_evaluated.load(std::memory_order_relaxed),
+      c.mnk_last_buttons.load(std::memory_order_relaxed),
+      c.mnk_a_hits.load(std::memory_order_relaxed), c.guest_u0.load(std::memory_order_relaxed),
+      c.guest_u0_buttons.load(std::memory_order_relaxed),
+      c.guest_u0_a.load(std::memory_order_relaxed),
+      c.guest_last_buttons.load(std::memory_order_relaxed),
+      c.guest_other.load(std::memory_order_relaxed),
+      c.guest_ks_calls.load(std::memory_order_relaxed),
+      c.guest_ks_ok.load(std::memory_order_relaxed));
+}
+
+/// window_sdl.cpp: one SDL key event reached the window. `vk` is 0 (kNone) when
+/// the scancode had no VirtualKey translation; `focused` is the SDL keyboard
+/// focus at the moment the event was handled.
+inline void ObserveSdlKey(bool down, uint32_t scancode, uint32_t vk, bool focused) {
+  if (!Enabled()) {
+    return;
+  }
+  Counters& c = C();
+  if (down) {
+    c.sdl_down.fetch_add(1, std::memory_order_relaxed);
+    if (vk != 0) {
+      c.sdl_down_mapped.fetch_add(1, std::memory_order_relaxed);
+    } else {
+      c.sdl_down_unmapped.fetch_add(1, std::memory_order_relaxed);
+    }
+  } else {
+    c.sdl_up.fetch_add(1, std::memory_order_relaxed);
+  }
+  c.last_scancode.store(scancode, std::memory_order_relaxed);
+  c.last_vk.store(vk, std::memory_order_relaxed);
+  c.last_focus.store(focused ? 1u : 0u, std::memory_order_relaxed);
+  MaybeFlush();
+}
+
+/// mnk_input_driver.cpp OnKeyDown: whether the key was accepted, or which gate
+/// rejected it.
+inline void ObserveMnkKeyDown(bool driver_enabled, bool driver_focused) {
+  if (!Enabled()) {
+    return;
+  }
+  Counters& c = C();
+  if (!driver_enabled) {
+    c.mnk_down_disabled.fetch_add(1, std::memory_order_relaxed);
+  } else if (!driver_focused) {
+    c.mnk_down_unfocused.fetch_add(1, std::memory_order_relaxed);
+  } else {
+    c.mnk_down_seen.fetch_add(1, std::memory_order_relaxed);
+  }
+  MaybeFlush();
+}
+
+/// mnk_input_driver.cpp GetDeviceState: which gate decided the returned state,
+/// and the button mask the bind parser produced on the evaluated path.
+inline void ObserveMnkState(bool active, bool focused, uint32_t buttons) {
+  if (!Enabled()) {
+    return;
+  }
+  Counters& c = C();
+  c.mnk_get.fetch_add(1, std::memory_order_relaxed);
+  if (!active) {
+    c.mnk_gate_inactive.fetch_add(1, std::memory_order_relaxed);
+  } else if (!focused) {
+    c.mnk_gate_unfocused.fetch_add(1, std::memory_order_relaxed);
+  } else {
+    c.mnk_evaluated.fetch_add(1, std::memory_order_relaxed);
+  }
+  c.mnk_last_buttons.store(buttons, std::memory_order_relaxed);
+  if (buttons & 0x1000u) {  // X_INPUT_GAMEPAD_A
+    c.mnk_a_hits.fetch_add(1, std::memory_order_relaxed);
+  }
+  MaybeFlush();
+}
+
+/// input_system.cpp GetState: what the guest read for guest user 0. Non-zero
+/// user indices are counted separately - the MnK device is synthetic and only
+/// feeds user 0, so a guest polling user 1..3 would see nothing.
+inline void ObserveGuestState(uint32_t user_index, bool connected, uint32_t buttons) {
+  if (!Enabled()) {
+    return;
+  }
+  Counters& c = C();
+  if (user_index != 0) {
+    c.guest_other.fetch_add(1, std::memory_order_relaxed);
+    MaybeFlush();
+    return;
+  }
+  c.guest_u0.fetch_add(1, std::memory_order_relaxed);
+  if (connected) {
+    c.guest_last_buttons.store(buttons, std::memory_order_relaxed);
+    if (buttons != 0) {
+      c.guest_u0_buttons.fetch_add(1, std::memory_order_relaxed);
+    }
+    if (buttons & 0x1000u) {  // X_INPUT_GAMEPAD_A
+      c.guest_u0_a.fetch_add(1, std::memory_order_relaxed);
+    }
+  }
+  MaybeFlush();
+}
+
+/// input_system.cpp GetKeystroke: whether the guest is polling keystrokes at
+/// all (Poll), and whether a driver ever produced one (Produced) - the MnK
+/// driver's keystroke queue is never filled today.
+inline void ObserveGuestKeystrokePoll(uint32_t user_index) {
+  if (!Enabled() || user_index != 0) {
+    return;
+  }
+  C().guest_ks_calls.fetch_add(1, std::memory_order_relaxed);
+  MaybeFlush();
+}
+
+inline void ObserveGuestKeystrokeProduced(uint32_t user_index) {
+  if (!Enabled() || user_index != 0) {
+    return;
+  }
+  C().guest_ks_ok.fetch_add(1, std::memory_order_relaxed);
+  MaybeFlush();
+}
+
+}  // namespace rex::input::diag
