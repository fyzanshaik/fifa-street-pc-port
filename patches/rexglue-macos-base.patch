+TEST_CASE("BitStream Write exact boundary and failed writes preserve memory", "[stream][bitstream]") {
+  std::array<uint8_t, 3> buffer = {0xAA, 0xFF, 0xBB};
+  BitStream stream(buffer.data() + 1, 8);
+  REQUIRE(stream.Write(0, 0));
+  REQUIRE(stream.Write(0x35, 8));
+  CHECK(buffer[0] == 0xAA);
+  CHECK(buffer[1] == 0x35);
+  CHECK(buffer[2] == 0xBB);
+  CHECK_FALSE(stream.Write(1, 1));
+  CHECK_FALSE(stream.Write(0, 58));
+  CHECK(stream.offset_bits() == 8);
