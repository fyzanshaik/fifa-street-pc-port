   CHECK((ctx.fpscr.getcsr() & ~kGuestMask) == (host_before & ~kGuestMask));
   CHECK(ctx.fpscr.csr == ctx.fpscr.getcsr());
 }
+
+
+namespace {
+void ThrowingDispatchFn(PPCContext& ctx, uint8_t*) {
+  ctx.r1.u64 -= 32;
+  ctx.lr = 0;
+  ctx.r14.u64 = 0;
+  throw 42;
+}
+}
+
+TEST_CASE("FunctionDispatcher: invalid ranges and unaligned functions are rejected",
+          "[runtime][dispatcher]") {
+  auto& memory = GetTestMemory();
+  rex::runtime::ExportResolver resolver;
+  rex::runtime::FunctionDispatcher dispatcher(&memory, &resolver);
+  CHECK_FALSE(dispatcher.InitializeFunctionTable(0xFFFFFF00u, 0x10000u,
+                                                 0xFFFFFF00u, 0x100000u));
+  CHECK_FALSE(dispatcher.InitializeFunctionTable(0x8B000001u, 0x10000u,
+                                                 0x8B000000u, 0x100000u));
+  REQUIRE(dispatcher.InitializeFunctionTable(0x8B000000u, 0x10000u,
+                                              0x8B000000u, 0x100000u));
+  CHECK_FALSE(dispatcher.SetFunction(0x8B000001u, &DummyFn));
+  CHECK(dispatcher.GetFunction(0x8B000001u) == nullptr);
+  REQUIRE(dispatcher.SetFunction(0x8B000000u, &DummyFn));
+  CHECK(dispatcher.GetFunction(0x8B000000u) == &DummyFn);
+}
+
+TEST_CASE("FunctionDispatcher: exceptions restore dispatch and trap state",
+          "[runtime][dispatcher]") {
+  auto& memory = GetTestMemory();
+  rex::runtime::ExportResolver resolver;
+  rex::runtime::FunctionDispatcher dispatcher(&memory, &resolver);
+  constexpr uint32_t base = 0x8A000000u;
+  REQUIRE(dispatcher.InitializeFunctionTable(base, 0x10000u, base, 0x100000u));
+  REQUIRE(dispatcher.SetFunction(base + 0x40, &ThrowingDispatchFn));
+  rex::runtime::ThreadState previous(1, 0x71000000u, 0x60000000u, &memory);
+  rex::runtime::ThreadState target(2, 0x70000000u, 0x60000000u, &memory);
+  auto* ctx = target.context();
+  ctx->lr = 0x12345678u;
+  ctx->r14.u64 = 0x14141414u;
+  rex::runtime::ThreadState::Bind(&previous);
+  SECTION("Execute") {
+    uint64_t args[] = {0};
+    REQUIRE_THROWS_AS(dispatcher.Execute(&target, base + 0x40, args, 1), int);
+  }
+  SECTION("ExecuteTrap") {
+    uint64_t args[] = {0};
+    REQUIRE_THROWS_AS(dispatcher.ExecuteTrap(&target, base + 0x40, args, 1), int);
+    CHECK(ctx->r14.u64 == 0x14141414u);
+  }
+  CHECK(ctx->r1.u64 == 0x70000000u);
+  CHECK(ctx->lr == 0x12345678u);
+  CHECK(rex::runtime::ThreadState::Get() == &previous);
+  rex::runtime::ThreadState::Bind(nullptr);
+}
