new file mode 100644
index 0000000..e637829
--- /dev/null
+++ b/src/ui/game_ui_fonts.cpp
@@ -0,0 +1,162 @@
+// Loads the game's own UI fonts (the TrueType files stored in data0.big) so that the overlays
+// drawn by the runtime use exactly the lettering of the original menus.
+//
+// data0.big is a BIG4 archive; the font entries are "chunklzx" blobs (Xbox 360 LZX):
+//   'chunklzx', version, total size, chunk size, chunk count, ..., then per chunk an 8-byte
+//   header (u32 compressed size, u32 3) followed by 32 KB LZX frames. Frames are
+//   [u16 size] (full frame) or [0xFF][u16 usize][u16 csize] (short last frame); the frame
+//   headers are not part of the LZX bitstream.
+
+#include <imgui.h>
+
+#include <rex/logging.h>
+#include <rex/system/lzx.h>
+#include <rex/ui/guide_font.h>
+
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <string>
+#include <vector>
+
+namespace rex::ui {
+
+ImFont* g_guide_font = nullptr;
+ImFont* g_guide_font_light = nullptr;
+
+namespace {
+
+uint32_t Be32(const uint8_t* p) {
+  return (uint32_t(p[0]) << 24) | (uint32_t(p[1]) << 16) | (uint32_t(p[2]) << 8) | p[3];
+}
+uint32_t Le32(const uint8_t* p) {
+  return (uint32_t(p[3]) << 24) | (uint32_t(p[2]) << 16) | (uint32_t(p[1]) << 8) | p[0];
+}
+uint16_t Be16(const uint8_t* p) { return uint16_t((p[0] << 8) | p[1]); }
+
+bool ReadAt(FILE* file, uint64_t offset, void* out, size_t size) {
+  if (_fseeki64(file, static_cast<long long>(offset), SEEK_SET) != 0) return false;
+  return std::fread(out, 1, size, file) == size;
+}
+
+bool DecompressChunkLzx(const std::vector<uint8_t>& data, std::vector<uint8_t>& out) {
+  if (data.size() < 48 || std::memcmp(data.data(), "chunklzx", 8) != 0) return false;
+  const uint32_t total = Be32(&data[12]);
+  const uint32_t chunk_size = Be32(&data[16]);
+  if (!total || !chunk_size || total > (64u << 20)) return false;
+  out.assign(total, 0);
+  size_t produced = 0;
+  size_t header = 40;
+  while (produced < total) {
+    if (header + 8 > data.size()) return false;
+    const uint32_t csize = Be32(&data[header]);
+    const size_t start = header + 8;
+    const size_t want = std::min<size_t>(chunk_size, total - produced);
+    std::vector<uint8_t> payload;
+    size_t pos = start, got = 0;
+    while (got < want) {
+      if (pos + 2 > data.size()) return false;
+      uint32_t usize = 32768, size;
+      size_t body;
+      if (data[pos] == 0xFF) {
+        if (pos + 5 > data.size()) return false;
+        usize = Be16(&data[pos + 1]);
+        size = Be16(&data[pos + 3]);
+        body = pos + 5;
+      } else {
+        size = Be16(&data[pos]);
+        body = pos + 2;
+      }
+      if (body + size > data.size()) return false;
+      payload.insert(payload.end(), data.begin() + body, data.begin() + body + size);
+      pos = body + size;
+      got += std::min<size_t>(usize, want - got);
+    }
+    if (lzx_decompress(payload.data(), payload.size(), out.data() + produced, want, 1u << 17,
+                       nullptr, 0) != 0) {
+      return false;
+    }
+    produced += want;
+    if (produced >= total) break;
+    // The next chunk header is (u32 size, u32 3) shortly after this chunk's data.
+    size_t next = 0;
+    for (size_t p = std::max(start + csize, start + 16) - 16; p < std::min(data.size() - 8, start + csize + 96);
+         ++p) {
+      if (data[p] == 0 && Be32(&data[p + 4]) == 3) {
+        const uint32_t size = Be32(&data[p]);
+        if (size > 0 && size <= data.size() - p - 8) {
+          next = p;
+          if (p + 4 >= start + csize) break;
+        }
+      }
+    }
+    if (!next) return false;
+    header = next;
+  }
+  return true;
+}
+
+// Finds `wanted` (lowercase file name suffix) in a BIG4 archive and returns its raw bytes.
+bool ReadBigEntry(FILE* file, const std::string& wanted, std::vector<uint8_t>& out) {
+  uint8_t head[16];
+  if (!ReadAt(file, 0, head, sizeof(head)) || std::memcmp(head, "BIG4", 4) != 0) return false;
+  const uint32_t count = Be32(&head[8]);
+  const uint32_t header_size = Be32(&head[12]);
+  if (header_size < 16 || header_size > (64u << 20)) return false;
+  std::vector<uint8_t> table(header_size - 16);
+  if (!ReadAt(file, 16, table.data(), table.size())) return false;
+  size_t p = 0;
+  for (uint32_t i = 0; i < count && p + 9 <= table.size(); ++i) {
+    const uint32_t offset = Be32(&table[p]);
+    const uint32_t size = Be32(&table[p + 4]);
+    p += 8;
+    size_t end = p;
+    while (end < table.size() && table[end]) ++end;
+    std::string name(reinterpret_cast<const char*>(&table[p]), end - p);
+    p = end + 1;
+    for (char& c : name) c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+    if (name == wanted) {
+      out.resize(size);
+      return ReadAt(file, offset, out.data(), size);
+    }
+  }
+  return false;
+}
+
+ImFont* AddFont(ImFontAtlas* atlas, FILE* big, const char* entry, float pixels) {
+  std::vector<uint8_t> raw, ttf;
+  if (!ReadBigEntry(big, entry, raw) || !DecompressChunkLzx(raw, ttf)) {
+    REXLOG_WARN("Game UI font {} could not be loaded", entry);
+    return nullptr;
+  }
+  void* copy = ImGui::MemAlloc(ttf.size());  // owned by the atlas
+  std::memcpy(copy, ttf.data(), ttf.size());
+  static const ImWchar ranges[] = {0x0020, 0x017F, 0};  // Latin, accents (ES/FR/DE/IT/PT)
+  ImFontConfig config;
+  config.OversampleH = config.OversampleV = 2;
+  return atlas->AddFontFromMemoryTTF(copy, static_cast<int>(ttf.size()), pixels, &config, ranges);
+}
+
+}  // namespace
+
+void LoadGameUiFonts(ImFontAtlas* atlas, const std::filesystem::path& game_data_root) {
+  const auto archive = game_data_root / "data0.big";
+  FILE* big = nullptr;
+#if defined(_WIN32)
+  _wfopen_s(&big, archive.c_str(), L"rb");
+#else
+  big = std::fopen(archive.string().c_str(), "rb");
+#endif
+  if (!big) {
+    REXLOG_WARN("Game UI fonts: {} not found", archive.string());
+    return;
+  }
+  g_guide_font = AddFont(atlas, big, "data/ui/fonts/fs4_cn_bold.ttf", 48.0f);
+  g_guide_font_light = AddFont(atlas, big, "data/ui/fonts/fs4_cn_regular.ttf", 48.0f);
+  std::fclose(big);
+  REXLOG_INFO("Game UI fonts loaded: bold={} regular={}", g_guide_font != nullptr,
+              g_guide_font_light != nullptr);
+}
+
+}  // namespace rex::ui
