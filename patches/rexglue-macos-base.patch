+TEST_CASE("BitStream reads a short final byte and a zero-length end", "[stream][bitstream]") {
+  std::array<uint8_t, 1> buffer = {0xA5};
+  BitStream stream(buffer.data(), 8);
+  CHECK(stream.Read(4) == 0xA);
+  CHECK(stream.Read(4) == 0x5);
+  CHECK(stream.Peek(0) == 0);
+  CHECK(stream.offset_bits() == 8);
+}
+
+TEST_CASE("BitStream Copy preserves alignment and untouched destination bits", "[stream][bitstream]") {
+  // Exhaust all short copy lengths and source bit offsets against a bit oracle.
+  for (size_t offset = 0; offset < 8; ++offset) {
+    for (size_t length = 0; length <= 24 - offset; ++length) {
+      std::array<uint8_t, 3> source = {0xA5, 0x3C, 0xF0};
+      std::array<uint8_t, 4> output = {0x5A, 0x5A, 0x5A, 0x5A};
+      auto expected = output;
+      for (size_t bit = offset; bit < offset + length; ++bit) {
+        const uint8_t mask = uint8_t(1u << (7 - (bit & 7)));
+        expected[bit / 8] = uint8_t((expected[bit / 8] & ~mask) | (source[bit / 8] & mask));
+      }
+      BitStream stream(source.data(), 24);
+      stream.SetOffset(offset);
+      REQUIRE(stream.Copy(output.data(), length) == offset);
+      REQUIRE(output == expected);
+      REQUIRE(stream.offset_bits() == offset + length);
+    }
+  }
+}
+
+TEST_CASE("ByteStream rejects overflow and truncated strings in Release", "[stream][bytestream]") {
+  std::array<uint8_t, 8> buffer{};
+  ByteStream stream(buffer.data(), buffer.size());
+  SECTION("Advance overflow") {
+    stream.Advance(1);
+    REQUIRE_THROWS_AS(stream.Advance(std::numeric_limits<size_t>::max()), std::out_of_range);
+    CHECK(stream.offset() == 1);
+  }
+  SECTION("Read outside buffer") {
+    stream.set_offset(buffer.size());
+    REQUIRE_THROWS_AS(stream.Read<uint32_t>(), std::out_of_range);
+    CHECK(stream.offset() == buffer.size());
+  }
+  SECTION("Write outside buffer") {
+    stream.set_offset(buffer.size());
+    REQUIRE_THROWS_AS(stream.Write(uint32_t(42)), std::out_of_range);
+    CHECK(buffer == std::array<uint8_t, 8>{});
+  }
+  SECTION("Truncated string length") {
+    stream.Write(uint32_t(0xFFFFFFFFu));
+    stream.set_offset(0);
+    REQUIRE_THROWS_AS(stream.Read<std::string>(), std::out_of_range);
+    stream.set_offset(0);
+    REQUIRE_THROWS_AS(stream.Read<std::u16string>(), std::out_of_range);
+  }
+}
diff --git a/tests/unit/system/function_dispatcher_test.cpp b/tests/unit/system/function_dispatcher_test.cpp
