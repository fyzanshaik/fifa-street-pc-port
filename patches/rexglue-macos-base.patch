diff --git a/src/kernel/xam/exit_overlay.cpp b/src/kernel/xam/exit_overlay.cpp
new file mode 100644
index 0000000..ebb9121
--- /dev/null
+++ b/src/kernel/xam/exit_overlay.cpp
@@ -0,0 +1,174 @@
+/**
+ * Exit shortcut: START + B (Xbox layout) / START + Circle (PlayStation layout) on any screen
+ * opens an "exit the game?" confirmation drawn in the game's own style; A confirms, B cancels.
+ */
+#include <atomic>
+#include <chrono>
+#include <memory>
+#include <string>
+#include <thread>
+
+#include <imgui.h>
+#include <spdlog/spdlog.h>
+#if defined(_WIN32)
+#include <windows.h>
+#endif
+
+#include <rex/input/guide_capture.h>
+#include <rex/logging.h>
+#include <rex/runtime.h>
+#include <rex/system/kernel_state.h>
+#include <rex/ui/guide_font.h>
+#include <rex/ui/imgui_dialog.h>
+#include <rex/ui/imgui_drawer.h>
+#include <rex/ui/windowed_app_context.h>
+
+namespace rex::kernel::xam {
+uint32_t XGetLanguage_entry();  // xam_info.cpp: the game's current language (XLanguage)
+}
+
+namespace rex {
+namespace kernel {
+namespace xam {
+namespace {
+
+enum class Str { kExitConfirm, kYes, kNo };
+
+// Texts per game language (XLanguage: 1 EN, 3 DE, 4 FR, 5 ES, 6 IT, 9 PT). Others use English.
+std::string Tr(Str id) {
+  struct Row { const char* en; const char* de; const char* fr; const char* es; const char* it; const char* pt; };
+  static const Row kRows[] = {
+      /*kExitConfirm*/ {"EXIT THE GAME?", "SPIEL BEENDEN?", "QUITTER LE JEU ?", "\xC2\xBFSALIR DEL JUEGO?",
+                        "USCIRE DAL GIOCO?", "SAIR DO JOGO?"},
+      /*kYes*/ {"YES", "JA", "OUI", "SI", "SI", "SIM"},
+      /*kNo*/ {"NO", "NEIN", "NON", "NO", "NO", "NAO"},
+  };
+  const Row& row = kRows[static_cast<size_t>(id)];
+  switch (XGetLanguage_entry()) {
+    case 3: return row.de;
+    case 4: return row.fr;
+    case 5: return row.es;
+    case 6: return row.it;
+    case 9: return row.pt;
+    default: return row.en;
+  }
+}
+
+// The game's look: slanted black bars, yellow highlight, heavy condensed caps.
+struct Style {
+  ImDrawList* dl;
+  ImFont* font;
+  float s;  // layout scale (display height / 720)
+
+  void Slant(float x, float y, float w, float h, ImU32 color, float skew = 14.0f) const {
+    const float k = skew * s;
+    ImVec2 pts[4] = {ImVec2(x + k, y), ImVec2(x + w + k, y), ImVec2(x + w, y + h), ImVec2(x, y + h)};
+    dl->AddConvexPolyFilled(pts, 4, color);
+  }
+  void Text(float x, float y, float size, ImU32 color, const std::string& text) const {
+    dl->AddText(font, size * s, ImVec2(x, y), color, text.c_str());
+  }
+  float TextWidth(float size, const std::string& text) const {
+    return font->CalcTextSizeA(size * s, 3.4e38f, 0.0f, text.c_str()).x;
+  }
+  // Round button glyph like the footer hints of the game: (A) text.
+  void Hint(float& x, float y, const char* letter, const char* label, ImU32 ring) const {
+    const float r = 15.0f * s;
+    dl->AddCircle(ImVec2(x + r, y + r), r, ring, 24, 2.5f * s);
+    const float lw = TextWidth(22, letter);
+    Text(x + r - lw * 0.5f, y + r - 11.0f * s, 22, ring, letter);
+    x += 2 * r + 10.0f * s;
+    Text(x, y + 1.0f * s, 24, IM_COL32(255, 255, 255, 255), label);
+    x += TextWidth(24, label) + 34.0f * s;
+  }
+};
+
+std::atomic_bool g_confirm{false};
+
+void DrawExit(float width, float height) {
+  constexpr uint32_t kA = 0x1000, kB = 0x2000;
+  // The chord is recorded by the input system while watching.
+  rex::input::SetBackWatch(!g_confirm.load());
+  if (!g_confirm.load() && rex::input::TakeBackPress()) g_confirm = true;
+
+  const bool confirm = g_confirm.load();
+  if (confirm != rex::input::GuideCaptureActive()) {
+    rex::input::SetGuideCapture(confirm);
+    if (confirm) rex::input::TakeGuidePresses();  // drop presses from before it opened
+  }
+  if (!confirm) return;
+  const uint32_t presses = rex::input::TakeGuidePresses();
+
+  ImFont* font = rex::ui::g_guide_font ? rex::ui::g_guide_font : ImGui::GetFont();
+  const float s = height / 720.0f;
+
+  ImGui::SetNextWindowPos(ImVec2(0, 0));
+  ImGui::SetNextWindowSize(ImVec2(width, height));
+  ImGui::SetNextWindowBgAlpha(0.0f);
+  ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(0, 0));
+  ImGui::PushStyleVar(ImGuiStyleVar_WindowBorderSize, 0.0f);
+  const ImGuiWindowFlags flags = ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_NoNav |
+                                 ImGuiWindowFlags_NoMove | ImGuiWindowFlags_NoSavedSettings |
+                                 ImGuiWindowFlags_NoInputs | ImGuiWindowFlags_NoBackground |
+                                 ImGuiWindowFlags_NoBringToFrontOnFocus;
+  if (ImGui::Begin("##exit_canvas", nullptr, flags)) {
+    Style g{ImGui::GetWindowDrawList(), font, s};
+    const float w = 560 * s, h = 132 * s, x = (width - w) * 0.5f, y = height * 0.5f - h * 0.5f;
+    g.dl->AddRectFilled(ImVec2(0, 0), ImVec2(width, height), IM_COL32(0, 0, 0, 150));
+    g.Slant(x - 6 * s, y - 6 * s, w + 12 * s, h + 12 * s, IM_COL32(244, 196, 12, 255));
+    g.Slant(x, y, w, h, IM_COL32(12, 12, 14, 240));
+    g.Text(x + 34 * s, y + 26 * s, 46, IM_COL32(255, 255, 255, 255), Tr(Str::kExitConfirm));
+    float hx = x + 34 * s;
+    g.Hint(hx, y + h - 46 * s, "A", Tr(Str::kYes).c_str(), IM_COL32(244, 196, 12, 255));
+    g.Hint(hx, y + h - 46 * s, "B", Tr(Str::kNo).c_str(), IM_COL32(255, 255, 255, 255));
+    if (presses & kA) {
+      REXKRNL_INFO("[EXIT] closing the game (START + B)");
+      g_confirm = false;
+      rex::input::SetGuideCapture(false);
+      if (auto logger = spdlog::default_logger()) logger->flush();
+#if defined(_WIN32)
+      TerminateProcess(GetCurrentProcess(), 0);  // clean exit code, no crash dialog
+#else
+      std::_Exit(0);
+#endif
+    } else if (presses & kB) {
+      g_confirm = false;
+    }
+  }
+  ImGui::End();
+  ImGui::PopStyleVar(2);
+}
+
+class ExitOverlayDialog : public rex::ui::ImGuiDialog {
+ public:
+  explicit ExitOverlayDialog(rex::ui::ImGuiDrawer* drawer) : rex::ui::ImGuiDialog(drawer) {}
+  void OnDraw(ImGuiIO& io) override { DrawExit(io.DisplaySize.x, io.DisplaySize.y); }
+};
+
+std::unique_ptr<ExitOverlayDialog> g_overlay;
+
+}  // namespace
+
+// Creates the overlay once the emulator's ImGui drawer exists.
+void StartExitOverlay() {
+  static std::atomic_bool started{false};
+  if (started.exchange(true)) return;
+  std::thread([]() {
+    for (;;) {
+      auto* state = REX_KERNEL_STATE();
+      const Runtime* emulator = state ? state->emulator() : nullptr;
+      rex::ui::ImGuiDrawer* drawer = emulator ? emulator->imgui_drawer() : nullptr;
+      rex::ui::WindowedAppContext* context = emulator ? emulator->app_context() : nullptr;
+      if (drawer && context) {
+        context->CallInUIThreadSynchronous([drawer]() { g_overlay = std::make_unique<ExitOverlayDialog>(drawer); });
+        REXKRNL_INFO("[EXIT] exit shortcut ready");
+        return;
+      }
+      std::this_thread::sleep_for(std::chrono::milliseconds(500));
+    }
+  }).detach();
+}
+
+}  // namespace xam
+}  // namespace kernel
+}  // namespace rex
