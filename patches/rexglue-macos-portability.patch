+#pragma once
+
+#include <memory>
+#include <rex/ui/overlay/achievement_notification.h>
+#include <rex/ui/windowed_app_context.h>
+
+namespace rex::ui {
+
+// Only acquire ownership on the UI thread: a callback already queued during
+// shutdown must not keep a dialog alive after its drawer/window is destroyed.
+inline bool DeferAchievementNotification(
+    WindowedAppContext& context, std::weak_ptr<AchievementNotificationDialog> notification,
+    const rex::system::AchievementEvent& event) {
+  return context.CallInUIThreadDeferred([notification, event] {
+    if (auto dialog = notification.lock()) {
+      dialog->Push(event);
+      dialog->RequestPaintFromUIThread();
+    }
+  });
+}
+
+}  // namespace rex::ui
