diff --git a/include/rex/perf/runtime_diagnostics.h b/include/rex/perf/runtime_diagnostics.h
new file mode 100644
index 0000000..d423b78
--- /dev/null
+++ b/include/rex/perf/runtime_diagnostics.h
@@ -0,0 +1,170 @@
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+
+namespace rex::perf::diagnostics {
+
+// No logging, allocation or session lock is taken by AudioProbe's record methods.
+// Submitted is called with the driver's queue mutex held; callback methods are
+// serialized by SDL's stream lock. Only atomic fields are read by the reporter.
+static_assert(std::atomic<uint64_t>::is_always_lock_free);
+inline void Max(std::atomic<uint64_t>& counter, uint64_t value) {
+  auto old = counter.load(std::memory_order_relaxed);
+  while (old < value && !counter.compare_exchange_weak(old, value, std::memory_order_relaxed)) {}
+}
+
+struct AudioProbe {
+  uint64_t id = 0;
+  uint32_t stream_channels = 0, device_channels = 0, device_rate = 0, device_frames = 0;
+  std::atomic<uint64_t> submitted{0}, consumed{0}, silence_blocks{0}, muted_blocks{0};
+  std::atomic<uint64_t> callbacks{0}, requested_bytes{0}, put_failures{0};
+  std::atomic<uint64_t> zero_pcm_blocks{0}, repeated_lag1{0}, repeated_lag4{0};
+  // Source content only: the guest supplies planar big-endian float32 PCM.
+  // Separate numerical silence (including -0) from repeated audible data.
+  std::atomic<uint64_t> silent_pcm_blocks{0}, nonzero_repeated_lag1{0}, nonzero_repeated_lag4{0};
+  std::atomic<uint64_t> pcm_samples{0}, pcm_nonfinite_samples{0}, pcm_out_of_range_samples{0};
+  // Positive IEEE float32 bits sort in magnitude order. Excludes NaN/Inf.
+  std::atomic<uint64_t> pcm_peak_bits{0};
+  std::atomic<uint64_t> queue_depth{0}, queue_max{0};
+  std::atomic<uint64_t> submit_gap_max_us{0}, callback_gap_max_us{0}, callback_max_us{0};
+  std::atomic<bool> closed{false};
+
+  void SetQueueDepth(uint64_t depth) {
+    queue_depth.store(depth, std::memory_order_relaxed);
+    Max(queue_max, depth);
+  }
+  void Submitted(uint64_t now, const void* pcm, size_t bytes, uint64_t depth) {
+    if (last_submit_ && now >= last_submit_) Max(submit_gap_max_us, now - last_submit_);
+    last_submit_ = now;
+    uint64_t hash = 14695981039346656037ull;
+    bool zero = true;
+    const auto* data = static_cast<const uint8_t*>(pcm);
+    for (size_t i = 0; i < bytes; ++i) {
+      hash = (hash ^ data[i]) * 1099511628211ull;
+      zero = zero && data[i] == 0;
+    }
+    bool silent = zero;
+    if (bytes && bytes % sizeof(float) == 0) {
+      uint64_t nonfinite = 0, out_of_range = 0, peak = 0;
+      silent = true;
+      for (size_t i = 0; i < bytes; i += sizeof(float)) {
+        const uint32_t magnitude = ((uint32_t(data[i]) << 24) |
+            (uint32_t(data[i + 1]) << 16) | (uint32_t(data[i + 2]) << 8) |
+            uint32_t(data[i + 3])) & 0x7FFFFFFFu;
+        silent = silent && magnitude == 0;
+        if (magnitude >= 0x7F800000u) {
+          ++nonfinite;
+        } else {
+          out_of_range += magnitude > 0x3F800000u;
+          if (magnitude > peak) peak = magnitude;
+        }
+      }
+      pcm_samples.fetch_add(bytes / sizeof(float), std::memory_order_relaxed);
+      pcm_nonfinite_samples.fetch_add(nonfinite, std::memory_order_relaxed);
+      pcm_out_of_range_samples.fetch_add(out_of_range, std::memory_order_relaxed);
+      Max(pcm_peak_bits, peak);
+    }
+    if (zero) zero_pcm_blocks.fetch_add(1, std::memory_order_relaxed);
+    if (silent) silent_pcm_blocks.fetch_add(1, std::memory_order_relaxed);
+    if (history_count_ && hash == history_[(history_count_ - 1) % 4]) {
+      repeated_lag1.fetch_add(1, std::memory_order_relaxed);
+      if (!silent) nonzero_repeated_lag1.fetch_add(1, std::memory_order_relaxed);
+    }
+    if (history_count_ >= 4 && hash == history_[history_count_ % 4]) {
+      repeated_lag4.fetch_add(1, std::memory_order_relaxed);
+      if (!silent) nonzero_repeated_lag4.fetch_add(1, std::memory_order_relaxed);
+    }
+    history_[history_count_++ % 4] = hash;
+    submitted.fetch_add(1, std::memory_order_relaxed);
+    SetQueueDepth(depth);
+  }
+  void BeginCallback(uint64_t now, int bytes) {
+    if (last_callback_ && now >= last_callback_) Max(callback_gap_max_us, now - last_callback_);
+    last_callback_ = now;
+    callbacks.fetch_add(1, std::memory_order_relaxed);
+    if (bytes > 0) requested_bytes.fetch_add(static_cast<uint64_t>(bytes), std::memory_order_relaxed);
+  }
+  void EndCallback(uint64_t start, uint64_t end) {
+    if (end >= start) Max(callback_max_us, end - start);
+  }
+
+ private:
+  uint64_t last_submit_ = 0, last_callback_ = 0, history_count_ = 0;
+  std::array<uint64_t, 4> history_{};
+};
+
+// This implementation resides in librexruntime, shared by the GPU plugin.
+// RESTREET_PERF_DIAG is a JSONL output path, read once at initialization.
+bool Enabled();
+uint64_t NowUs();
+uint64_t ThreadCpuUs();
+uint64_t ThreadId();
+std::shared_ptr<AudioProbe> RegisterAudio(uint32_t stream_channels, uint32_t device_channels,
+                                         uint32_t device_rate, uint32_t device_frames);
+
+enum class Stage : uint32_t {
+  kShaderTranslation, kShaderModule, kGraphicsPipeline,
+  kCommandBatch, kCommandIdle, kRegisterWait, kGuestSwapCall, kGpuSwap,
+  kRefreshOutput, kEndSubmission, kFenceWait, kQueueSubmit, kHostPaint,
+  kHostPresent, kPresenterFenceWait, kQueueAcquire, kGuestSubmitCall,
+  kHostSubmitCall, kCount
+};
+enum class Point : uint32_t {
+  kGuestSwapWritten, kSwapProcessed, kOutputPublished, kPresentQueued,
+  kSubmissionQueued, kCompletionObserved, kGpuDuration, kGpuQueryStatus,
+  kGpuCapabilities, kWindowPaint, kWindowPaintEvent, kWindowPaintRequest,
+  kUiRepaintDecision, kToastRepaintDecision, kCount
+};
+void Mark(Point point, uint64_t key1 = 0, uint64_t key2 = 0,
+          uint64_t value = 0, int32_t result = 0);
+uint64_t CurrentFrame();
+class FrameScope {
+ public:
+  explicit FrameScope(uint64_t frame);
+  ~FrameScope();
+  FrameScope(const FrameScope&) = delete;
+  FrameScope& operator=(const FrameScope&) = delete;
+ private:
+  uint64_t previous_;
+};
+void BeginStage(Stage stage);
+void EndStage(Stage stage, uint64_t start, uint64_t end, int32_t result,
+              uint64_t key1, uint64_t key2, uint64_t cpu_us = 0, uint64_t thread_id = 0);
+
+class StageScope {
+ public:
+  explicit StageScope(Stage stage, uint64_t key1 = 0, uint64_t key2 = 0)
+      : stage_(stage), key1_(key1), key2_(key2), enabled_(Enabled()) {
+    if (enabled_) { start_ = NowUs(); cpu_start_ = ThreadCpuUs(); BeginStage(stage_); }
+  }
+  ~StageScope() { Finish(-1); }
+  StageScope(const StageScope&) = delete;
+  StageScope& operator=(const StageScope&) = delete;
+  void Finish(int32_t result) {
+    if (!enabled_) return;
+    const auto end = NowUs(), cpu_end = ThreadCpuUs();
+    EndStage(stage_, start_, end, result, key1_, key2_,
+             cpu_end >= cpu_start_ ? cpu_end - cpu_start_ : 0, ThreadId());
+    enabled_ = false;
+  }
+
+ private:
+  Stage stage_;
+  uint64_t key1_, key2_, start_ = 0, cpu_start_ = 0;
+  bool enabled_;
+};
+// Records duration on every return path. Result 0 denotes scope completion,
+// not success of the wrapped function; use StageScope for a real return code.
+class DurationScope {
+ public:
+  explicit DurationScope(Stage stage, uint64_t key1 = 0, uint64_t key2 = 0)
+      : scope_(stage, key1, key2) {}
+  ~DurationScope() { scope_.Finish(0); }
+ private:
+  StageScope scope_;
+};
+}  // namespace rex::perf::diagnostics
