+#pragma once
+
+#include <rex/filesystem.h>
+
+namespace rex::graphics::vulkan {
+
+// Append writes must preserve previous entries; reads must begin at the header.
+// The initial read position of a+b differs between libc implementations.
+inline FILE* OpenShaderStorageFile(const std::filesystem::path& path) {
+  FILE* file = rex::filesystem::OpenFile(path, "a+b");
+  if (file && !rex::filesystem::Seek(file, 0, SEEK_SET)) {
+    fclose(file);
+    return nullptr;
+  }
+  return file;
+}
+
+}  // namespace rex::graphics::vulkan
