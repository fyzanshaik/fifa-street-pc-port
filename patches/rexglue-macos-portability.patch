diff --git a/src/core/guest_clock_mapping.h b/src/core/guest_clock_mapping.h
new file mode 100644
index 0000000..709a824
--- /dev/null
+++ b/src/core/guest_clock_mapping.h
@@ -0,0 +1,108 @@
+// Mac guest clock: readers never advance shared time or discard tick fractions.
+#pragma once
+
+#include <atomic>
+#include <bit>
+#include <cstdint>
+#include <limits>
+#include <mutex>
+
+namespace rex::chrono::detail {
+
+struct GuestClockSnapshot {
+  uint64_t host_anchor = 0;
+  uint64_t guest_anchor = 0;
+  uint64_t numerator = 1;
+  uint64_t denominator = 1;
+  uint64_t frequency = 1;
+  double scalar = 1.0;
+  uint64_t system_base = 0;
+  uint64_t host_now = 0;
+
+  static uint64_t Convert(uint64_t value, uint64_t numerator, uint64_t denominator) {
+    uint64_t product;
+    // Nearly all reads fit in 64 bits. Keep wide division off the hot path
+    // while retaining correct conversion after long uptimes / at large ratios.
+    if (!__builtin_mul_overflow(value, numerator, &product)) return product / denominator;
+    const auto result = static_cast<unsigned __int128>(value) * numerator / denominator;
+    return result > UINT64_MAX ? UINT64_MAX : static_cast<uint64_t>(result);
+  }
+  uint64_t Ticks() const {
+    const auto delta = host_now > host_anchor ? host_now - host_anchor : 0;
+    const auto ticks = Convert(delta, numerator, denominator);
+    return ticks > UINT64_MAX - guest_anchor ? UINT64_MAX : guest_anchor + ticks;
+  }
+  uint64_t SystemOffset() const { return Convert(Ticks(), 10000000, frequency); }
+};
+
+class GuestClockMapping {
+ public:
+  GuestClockMapping(uint64_t host_anchor, uint64_t frequency, uint64_t system_base)
+      : host_anchor_(host_anchor), frequency_(frequency), system_base_(system_base) {}
+
+  // All payload fields are atomic: retrying a sequence read must not create a
+  // C++ data race. Single writers hold writer_mutex_. A failed read takes the
+  // mutex rather than spinning if the writer was descheduled.
+  template <typename QueryHost>
+  GuestClockSnapshot Read(QueryHost query_host) const {
+    const auto before = sequence_.load(std::memory_order_acquire);
+    if (!(before & 1)) {
+      auto state = Load();
+      state.host_now = query_host();
+      std::atomic_thread_fence(std::memory_order_acquire);
+      if (sequence_.load(std::memory_order_relaxed) == before) return state;
+    }
+    std::lock_guard lock(writer_mutex_);
+    auto state = Load();
+    state.host_now = query_host();
+    return state;
+  }
+
+  template <typename QueryHost, typename Mutate>
+  void Update(QueryHost query_host, Mutate mutate) {
+    std::lock_guard lock(writer_mutex_);
+    auto state = Load();
+    const auto sequence = sequence_.load(std::memory_order_relaxed);
+    sequence_.store(sequence + 1, std::memory_order_relaxed);
+    std::atomic_thread_fence(std::memory_order_release);
+    // Invalidate readers before sampling the rebase time. Otherwise a reader
+    // could return old-rate ticks beyond the new anchor during a slowdown.
+    state.host_now = query_host();
+    state.guest_anchor = state.Ticks();
+    state.host_anchor = state.host_now;
+    mutate(state);
+    host_anchor_.store(state.host_anchor, std::memory_order_relaxed);
+    guest_anchor_.store(state.guest_anchor, std::memory_order_relaxed);
+    numerator_.store(state.numerator, std::memory_order_relaxed);
+    denominator_.store(state.denominator, std::memory_order_relaxed);
+    frequency_.store(state.frequency, std::memory_order_relaxed);
+    scalar_bits_.store(std::bit_cast<uint64_t>(state.scalar), std::memory_order_relaxed);
+    system_base_.store(state.system_base, std::memory_order_relaxed);
+    sequence_.store(sequence + 2, std::memory_order_release);
+  }
+
+ private:
+  GuestClockSnapshot Load() const {
+    GuestClockSnapshot state;
+    state.host_anchor = host_anchor_.load(std::memory_order_relaxed);
+    state.guest_anchor = guest_anchor_.load(std::memory_order_relaxed);
+    state.numerator = numerator_.load(std::memory_order_relaxed);
+    state.denominator = denominator_.load(std::memory_order_relaxed);
+    state.frequency = frequency_.load(std::memory_order_relaxed);
+    state.scalar = std::bit_cast<double>(scalar_bits_.load(std::memory_order_relaxed));
+    state.system_base = system_base_.load(std::memory_order_relaxed);
+    return state;
+  }
+  static_assert(std::atomic<uint64_t>::is_always_lock_free);
+  mutable std::mutex writer_mutex_;
+  std::atomic<uint64_t> sequence_{0};
+  std::atomic<uint64_t> host_anchor_;
+  std::atomic<uint64_t> guest_anchor_{0};
+  std::atomic<uint64_t> numerator_{1};
+  std::atomic<uint64_t> denominator_{1};
+  std::atomic<uint64_t> frequency_;
+  std::atomic<uint64_t> scalar_bits_{std::bit_cast<uint64_t>(1.0)};
+  std::atomic<uint64_t> system_base_;
+};
+
+}  // namespace rex::chrono::detail
