+FrameScope::FrameScope(uint64_t frame) : previous_(current_frame) { current_frame = frame; }
+FrameScope::~FrameScope() { current_frame = previous_; }
+namespace {
+constexpr size_t kStageCount = static_cast<size_t>(Stage::kCount);
+constexpr const char* kNames[] = {"shader_translation", "shader_module", "graphics_pipeline",
+  "command_batch", "command_idle", "register_wait", "guest_swap_call", "gpu_swap",
+  "refresh_output", "end_submission", "fence_wait", "queue_submit", "host_paint", "host_present",
+  "presenter_fence_wait", "queue_acquire", "guest_submit_call", "host_submit_call"};
+constexpr const char* kPointNames[] = {"guest_swap_written", "swap_processed", "output_published",
+  "present_queued", "submission_queued", "completion_observed", "gpu_duration", "gpu_query_status",
+  "gpu_capabilities", "window_paint", "window_paint_event", "window_paint_request",
+  "ui_repaint_decision", "toast_repaint_decision"};
+static_assert(std::size(kNames) == kStageCount);
+static_assert(std::size(kPointNames) == static_cast<size_t>(Point::kCount));
+struct Event { Stage stage; uint64_t start, end, key1, key2; int32_t result;
+  uint64_t cpu_us, thread_id; };
+struct PointEvent { Point point; uint64_t at, key1, key2, value, thread_id; int32_t result; };
+struct StageCounters {
+  std::atomic<uint64_t> count{0}, total_us{0}, max_us{0}, active{0}, failures{0}, cpu_us{0};
+};
+struct Session {
+  std::FILE* file = nullptr;
+  uint64_t anchor = 0, next_id = 1, dropped = 0;
+  std::mutex mutex;
+  std::condition_variable wake;
+  bool stopping = false;
+  std::thread reporter;
+  std::vector<std::shared_ptr<AudioProbe>> audio;
+  std::array<StageCounters, kStageCount> stages;
+  std::array<Event, 512> events{};
+  size_t event_count = 0;
+  std::array<PointEvent, 4096> points{};
+  size_t point_count = 0;
+  uint64_t points_dropped = 0;
+
+  Session() {
+#if defined(__APPLE__)
+    const char* path = std::getenv("RESTREET_PERF_DIAG");
+    if (!path || !*path) return;
+    file = std::fopen(path, "w");
+    if (!file) { std::fprintf(stderr, "RESTREET_PERF_DIAG: cannot open output\n"); return; }
+    anchor = NowUs();
+    const auto unix_us = std::chrono::duration_cast<std::chrono::microseconds>(
+        std::chrono::system_clock::now().time_since_epoch()).count();
+    std::fprintf(file, "{\"type\":\"session\",\"version\":1,\"steady_anchor_us\":%llu,"
+                       "\"unix_anchor_us\":%lld,\"audio_block_frames\":256,\"audio_rate\":48000,"
+                       "\"frame_trace_version\":1,\"stage_detail_threshold_us\":1000}\n",
+                 static_cast<unsigned long long>(anchor), static_cast<long long>(unix_us));
+    std::fflush(file);
+    reporter = std::thread([this] {
+      std::unique_lock<std::mutex> lock(mutex);
+      while (!wake.wait_for(lock, std::chrono::seconds(1), [this] { return stopping; })) {
+        lock.unlock(); Report(); lock.lock();
+      }
+    });
+#endif
+  }
+  ~Session() {
+    if (!file) return;
+    { std::lock_guard<std::mutex> lock(mutex); stopping = true; }
+    wake.notify_all();
+    reporter.join();
+    Report();
+    std::fclose(file);
+  }
+  void Report() {
+    // Never hold the session lock during disk writes; no audio path takes it.
+    std::vector<std::shared_ptr<AudioProbe>> probes;
+    std::array<Event, 512> batch;
+    std::array<PointEvent, 4096> point_batch;
+    size_t count;
+    uint64_t dropped_copy;
+    { std::lock_guard<std::mutex> lock(mutex);
+      probes = audio; count = event_count; dropped_copy = dropped;
+      std::copy_n(events.begin(), count, batch.begin()); event_count = 0;
+    }
+    size_t points_count;
+    uint64_t lost_points;
+    { std::lock_guard<std::mutex> lock(mutex);
+      points_count = point_count; lost_points = points_dropped;
+      std::copy_n(points.begin(), points_count, point_batch.begin()); point_count = 0;
+    }
+    const auto elapsed = static_cast<unsigned long long>(NowUs() - anchor);
+    for (const auto& p : probes) {
+      // Probes are retained for the session so short-lived drivers remain visible.
+      std::fprintf(file, "{\"type\":\"audio\",\"elapsed_us\":%llu,\"id\":%llu,"
+          "\"stream_channels\":%u,\"device_channels\":%u,\"device_rate\":%u,\"device_frames\":%u",
+          elapsed, static_cast<unsigned long long>(p->id), p->stream_channels,
+          p->device_channels, p->device_rate, p->device_frames);
+#define FIELD(name) std::fprintf(file, ",\"" #name "\":%llu", \
+    static_cast<unsigned long long>(p->name.load(std::memory_order_relaxed)))
+      FIELD(submitted); FIELD(consumed); FIELD(silence_blocks); FIELD(muted_blocks);
+      FIELD(callbacks); FIELD(requested_bytes); FIELD(put_failures); FIELD(zero_pcm_blocks);
+      FIELD(repeated_lag1); FIELD(repeated_lag4); FIELD(queue_depth); FIELD(queue_max);
+      FIELD(silent_pcm_blocks); FIELD(nonzero_repeated_lag1); FIELD(nonzero_repeated_lag4);
+      FIELD(pcm_samples); FIELD(pcm_nonfinite_samples); FIELD(pcm_out_of_range_samples);
+      FIELD(pcm_peak_bits);
+      FIELD(submit_gap_max_us); FIELD(callback_gap_max_us); FIELD(callback_max_us);
+      FIELD(closed);
+#undef FIELD
+      std::fputs("}\n", file);
+    }
+    for (size_t i = 0; i < count; ++i) {
+      const auto& e = batch[i];
+      std::fprintf(file, "{\"type\":\"stage_event\",\"stage\":\"%s\",\"start_us\":%llu,"
+          "\"end_us\":%llu,\"duration_us\":%llu,\"result\":%d,\"key1\":%llu,\"key2\":%llu,"
+          "\"cpu_us\":%llu,\"thread_id\":%llu}\n",
+          kNames[static_cast<size_t>(e.stage)], static_cast<unsigned long long>(e.start - anchor),
+          static_cast<unsigned long long>(e.end - anchor), static_cast<unsigned long long>(e.end - e.start),
+          e.result, static_cast<unsigned long long>(e.key1), static_cast<unsigned long long>(e.key2),
+          static_cast<unsigned long long>(e.cpu_us), static_cast<unsigned long long>(e.thread_id));
+    }
+    for (size_t i = 0; i < kStageCount; ++i) {
+      const auto& s = stages[i];
+      std::fprintf(file, "{\"type\":\"stage_summary\",\"elapsed_us\":%llu,\"stage\":\"%s\","
+          "\"count\":%llu,\"total_us\":%llu,\"max_us\":%llu,\"active\":%llu,"
+          "\"failures\":%llu,\"dropped_events\":%llu,\"cpu_us\":%llu}\n", elapsed, kNames[i],
+          static_cast<unsigned long long>(s.count.load()), static_cast<unsigned long long>(s.total_us.load()),
+          static_cast<unsigned long long>(s.max_us.load()), static_cast<unsigned long long>(s.active.load()),
+          static_cast<unsigned long long>(s.failures.load()), static_cast<unsigned long long>(dropped_copy),
+          static_cast<unsigned long long>(s.cpu_us.load()));
+    }
+    for (size_t i = 0; i < points_count; ++i) {
+      const auto& p = point_batch[i];
+      std::fprintf(file, "{\"type\":\"frame_point\",\"point\":\"%s\",\"elapsed_us\":%llu,"
+          "\"key1\":%llu,\"key2\":%llu,\"value\":%llu,\"result\":%d,\"thread_id\":%llu}\n",
+          kPointNames[static_cast<size_t>(p.point)], static_cast<unsigned long long>(p.at-anchor),
+          static_cast<unsigned long long>(p.key1), static_cast<unsigned long long>(p.key2),
+          static_cast<unsigned long long>(p.value), p.result, static_cast<unsigned long long>(p.thread_id));
+    }
+    std::fprintf(file, "{\"type\":\"frame_summary\",\"elapsed_us\":%llu,\"dropped_points\":%llu}\n",
+        elapsed, static_cast<unsigned long long>(lost_points));
+#if defined(__APPLE__)
+    // Query running threads without suspending them or walking their stacks.
+    const auto cpu_start = NowUs();
+    thread_act_array_t threads = nullptr;
+    mach_msg_type_number_t thread_count = 0;
+    const auto task_result = task_threads(mach_task_self(), &threads, &thread_count);
+    uint64_t failures = 0;
+    if (task_result == KERN_SUCCESS) {
+      for (mach_msg_type_number_t i = 0; i < thread_count; ++i) {
+        thread_identifier_info_data_t id{};
+        thread_basic_info_data_t info{};
+        thread_extended_info_data_t extended{};
+        mach_msg_type_number_t n = THREAD_IDENTIFIER_INFO_COUNT;
+        const auto id_result = thread_info(threads[i], THREAD_IDENTIFIER_INFO, reinterpret_cast<thread_info_t>(&id), &n);
+        n = THREAD_BASIC_INFO_COUNT;
+        const auto info_result = thread_info(threads[i], THREAD_BASIC_INFO, reinterpret_cast<thread_info_t>(&info), &n);
+        n = THREAD_EXTENDED_INFO_COUNT;
+        const auto name_result = thread_info(threads[i], THREAD_EXTENDED_INFO, reinterpret_cast<thread_info_t>(&extended), &n);
+        if (id_result == KERN_SUCCESS && info_result == KERN_SUCCESS) {
+          // Basic info specifies seconds/microseconds; do not infer extended units.
+          const uint64_t cpu_us = uint64_t(info.user_time.seconds + info.system_time.seconds)*1000000 +
+              uint64_t(info.user_time.microseconds + info.system_time.microseconds);
+          std::fprintf(file, "{\"type\":\"thread_cpu\",\"elapsed_us\":%llu,\"thread_id\":%llu,"
+              "\"cpu_us\":%llu,\"run_state\":%d,\"name\":\"",
+              static_cast<unsigned long long>(NowUs()-anchor), static_cast<unsigned long long>(id.thread_id),
+              static_cast<unsigned long long>(cpu_us), info.run_state);
+          if (name_result == KERN_SUCCESS) for (char c : extended.pth_name) {
+            if (!c) break;
+            const auto b = static_cast<unsigned char>(c);
+            if (c == '"' || c == '\\') std::fputc('\\',file);
+            if (b < 32 || b >= 127) std::fprintf(file,"\\u%04x",unsigned(b));
+            else std::fputc(c,file);
+          }
+          std::fputs("\"}\n",file);
+        } else ++failures;
+        mach_port_deallocate(mach_task_self(), threads[i]);
+      }
+      vm_deallocate(mach_task_self(), reinterpret_cast<vm_address_t>(threads),
+          vm_size_t(thread_count)*sizeof(thread_act_t));
+    }
+    std::fprintf(file, "{\"type\":\"thread_cpu_status\",\"elapsed_us\":%llu,\"result\":%d,"
+        "\"threads\":%u,\"failures\":%llu,\"collection_us\":%llu}\n",
+        static_cast<unsigned long long>(NowUs()-anchor), task_result, thread_count,
+        static_cast<unsigned long long>(failures), static_cast<unsigned long long>(NowUs()-cpu_start));
+#endif
+    std::fflush(file);
+  }
+};
+Session& GetSession() { static Session session; return session; }
+}  // namespace
+bool Enabled() { return GetSession().file != nullptr; }
+std::shared_ptr<AudioProbe> RegisterAudio(uint32_t channels, uint32_t device_channels,
+                                         uint32_t device_rate, uint32_t device_frames) {
+  auto& s = GetSession();
+  if (!s.file) return nullptr;
+  auto probe = std::make_shared<AudioProbe>();
+  probe->stream_channels = channels; probe->device_channels = device_channels;
+  probe->device_rate = device_rate; probe->device_frames = device_frames;
+  std::lock_guard<std::mutex> lock(s.mutex);
+  probe->id = s.next_id++;
+  s.audio.push_back(probe);
+  return probe;
+}
+void BeginStage(Stage stage) { GetSession().stages[static_cast<size_t>(stage)].active.fetch_add(1); }
+void EndStage(Stage stage, uint64_t start, uint64_t end, int32_t result,
+              uint64_t key1, uint64_t key2, uint64_t cpu_us, uint64_t thread_id) {
+  auto& s = GetSession();
+  auto& counters = s.stages[static_cast<size_t>(stage)];
+  counters.count.fetch_add(1); counters.total_us.fetch_add(end - start);
+  Max(counters.max_us, end - start); counters.active.fetch_sub(1);
+  counters.cpu_us.fetch_add(cpu_us, std::memory_order_relaxed);
+  if (result != 0) counters.failures.fetch_add(1);
+  // Detailed records for new frequent stages are limited to >=1 ms or failures.
+  // Every completed operation still contributes to aggregate counters.
+  if (stage >= Stage::kCommandBatch && end-start < 1000 && result == 0) return;
+  std::lock_guard<std::mutex> lock(s.mutex);
+  if (s.event_count == s.events.size()) { ++s.dropped; return; }
+  s.events[s.event_count++] = {stage, start, end, key1, key2, result, cpu_us, thread_id};
+}
+void Mark(Point point, uint64_t key1, uint64_t key2, uint64_t value, int32_t result) {
+  auto& s = GetSession();
+  if (!s.file) return;
+  const auto at = NowUs(), id = ThreadId();
+  std::lock_guard<std::mutex> lock(s.mutex);
+  if (s.point_count == s.points.size()) { ++s.points_dropped; return; }
+  s.points[s.point_count++] = {point, at, key1, key2, value, id, result};
+}
+}  // namespace rex::perf::diagnostics
